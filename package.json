{
	"name": "deskkit",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		"./sidecar": "./src/sidecar/index.ts",
		"./sqlite": "./src/sqlite/index.ts",
		"./sqlite/testing": "./src/sqlite/testing.ts"
	},
	"bin": {
		"deskkit": "./src/cli.ts"
	},
	"scripts": {
		"format": "biome check --write",
		"check:type": "tsc --noEmit",
		"check:lint": "biome lint .",
		"test": "bun --bun vitest run"
	},
	"peerDependencies": {
		"@effect/platform-bun": "^4.0.0-rc.112",
		"@effect/sql-sqlite-bun": "^4.0.0-rc.112",
		"drizzle-orm": "^1.0.0-rc.5",
		"effect": "^4.0.0-rc.112"
	},
	"peerDependenciesMeta": {
		"@effect/sql-sqlite-bun": {
			"optional": true
		},
		"drizzle-orm": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@effect/platform-bun": "4.0.0-rc.112",
		"@effect/sql-sqlite-bun": "4.0.0-rc.112",
		"@effect/vitest": "4.0.0-rc.112",
		"@total-typescript/tsconfig": "1.0.4",
		"@types/bun": "1.3.14",
		"drizzle-kit": "1.0.0-rc.5-ab785fc",
		"drizzle-orm": "1.0.0-rc.5-ab785fc",
		"effect": "4.0.0-rc.112",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"packageManager": "pnpm@12.0.0-rc.8",
	"devEngines": {
		"runtime": {
			"name": "bun",
			"version": "latest",
			"onFail": "download"
		}
	}
}
